# ==================== 通用配置 ====================
# 时区配置
TZ=Asia/Shanghai

# Spring 环境配置 (local, dev, prod)
SPRING_PROFILES_ACTIVE=prod

# ===================== 前端配置 =====================
APP_PORT=80
VITE_BASE_URL=http://localhost:48080
VITE_DEFAULT_LOCALE=zh-CN
VITE_ENV=dev
NODE_ENV=dev
VITE_APP_TENANT_ENABLE=true
VITE_APP_DEFAULT_TENANT_ID=1
VITE_APP_DEFAULT_LOGIN_TENANT=default

# ==================== 数据库配置 ====================
# PostgreSQL 配置
POSTGRES_PORT=5433
POSTGRES_DB=app
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DATA_PATH=./volumes/postgres-data

# PostgreSQL 从库配置（可选，主从分离）
DB_SLAVE_HOST=postgres
DB_SLAVE_PORT=5432
DB_SLAVE_NAME=app
DB_SLAVE_USERNAME=root
DB_SLAVE_PASSWORD=123456

# MySQL 配置（Nacos 使用，仅生产环境需要）
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATA_PATH=./volumes/mysql-data


# ==================== 缓存配置 ====================
# Redis 配置
REDIS_PORT=6380
REDIS_PASSWORD=123456
REDIS_DATABASE=0
REDIS_DATA_PATH=./volumes/redis-data


# ==================== 注册中心/配置中心 ====================
# Nacos 配置（仅微服务模式需要）
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_SERVER_PORT=9849
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=
NACOS_LOGS_PATH=./volumes/nacos-logs
NACOS_DATA_PATH=./volumes/nacos-data


# ==================== 文件存储配置 ====================
# MinIO 配置
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_PATH=./volumes/minio-data


# ==================== 数据库管理工具 ====================
# PgAdmin 配置
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5051
PGADMIN_DATA_PATH=./volumes/pgadmin-data


# ==================== 微服务端口配置 ====================
# Yudao Gateway 网关服务
GATEWAY_PORT=48080

# Yudao System 系统功能模块
SYSTEM_PORT=48081

# Yudao Infra 基础设施模块
INFRA_PORT=48082

# Yudao BPM 工作流模块
BPM_PORT=48083


# ==================== JVM 参数配置 ====================
# Gateway JVM 参数
GATEWAY_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# System 模块 JVM 参数
SYSTEM_JAVA_OPTS=-Xms512m -Xmx1g -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# Infra 模块 JVM 参数
INFRA_JAVA_OPTS=-Xms512m -Xmx1g -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# BPM 模块 JVM 参数
BPM_JAVA_OPTS=-Xms512m -Xmx1g -XX:+UseG1GC -XX:MaxGCPauseMillis=200


# ==================== 微服务数据卷配置 ====================
# Gateway 日志路径
GATEWAY_LOGS_PATH=./volumes/yudao-gateway-logs

# System 模块日志路径
SYSTEM_LOGS_PATH=./volumes/yudao-system-logs

# Infra 模块日志路径
INFRA_LOGS_PATH=./volumes/yudao-infra-logs

# Infra 模块文件存储路径
INFRA_FILES_PATH=./volumes/yudao-files

# BPM 模块日志路径
BPM_LOGS_PATH=./volumes/yudao-bpm-logs


# ==================== 消息队列配置（可选）====================
# RocketMQ 配置
ROCKETMQ_NAME_SERVER=
ROCKETMQ_PORT=9876

# RabbitMQ 配置
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Kafka 配置
KAFKA_SERVERS=
KAFKA_HOST=127.0.0.1
KAFKA_PORT=9092


# ==================== 定时任务配置（可选）====================
# XXL-Job 配置
XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=
JOB_HOST=127.0.0.1
JOB_PORT=9090
