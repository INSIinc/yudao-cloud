# ====================================================
# 本地生产环境配置文件
# 请根据你的实际环境修改以下配置
# ====================================================

# ==================== 数据库配置 ====================
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=app
DB_USERNAME=postgres
DB_PASSWORD=123456

# ==================== Redis 配置 ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# ==================== 其他可选配置 ====================
# XXL Job 配置（如果不使用可以保持默认）
XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:9090/xxl-job-admin

# RocketMQ 配置（如果不使用可以保持默认）
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# RabbitMQ 配置（如果不使用可以保持默认）
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbit
RABBITMQ_PASSWORD=rabbit

# Kafka 配置（如果不使用可以保持默认）
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Spring Boot Admin 配置
SPRING_BOOT_ADMIN_ENABLED=false

# 日志配置
LOGGING_FILE_PATH=/tmp/yudao-logs
